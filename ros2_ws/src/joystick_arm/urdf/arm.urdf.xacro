<?xml version="1.0"?>
<robot name="advanced_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="world"/>
  <joint name="fixed_base" type="fixed"><parent link="world"/><child link="base_link"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

  <!-- ENDÜSTRİYEL TABAN ŞASİSİ -->
  <link name="base_link">
    <visual><origin xyz="0 0 0.03"/><geometry><cylinder radius="0.17" length="0.06"/></geometry></visual>
    <visual><origin xyz="0 0 0.08"/><geometry><cylinder radius="0.13" length="0.04"/></geometry></visual>
    <inertial><mass value="5.0"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/></inertial>
  </link>
  <gazebo reference="base_link"><material>Gazebo/DarkGrey</material></gazebo>

  <!-- DÖNER OMUZ TARETİ + ÇİFT SERVO TAMBURU -->
  <joint name="joint_1" type="revolute"><parent link="base_link"/><child link="link_1"/><origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" effort="100.0" velocity="2.0"/><dynamics damping="2.0" friction="1.0"/></joint>
  <link name="link_1">
    <visual><origin xyz="0 0 0.045"/><geometry><cylinder radius="0.105" length="0.09"/></geometry></visual>
    <visual><origin xyz="0 0 0.095" rpy="1.5708 0 0"/><geometry><cylinder radius="0.065" length="0.16"/></geometry></visual>
    <inertial><mass value="2.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <gazebo reference="link_1"><material>Gazebo/Orange</material><gravity>false</gravity></gazebo>

  <!-- ANA KOL (HİDROLİK PİSTON + DİRSEK MOTOR TAMBURU) -->
  <joint name="joint_2" type="revolute"><parent link="link_1"/><child link="link_2"/><origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-1.57" upper="1.57" effort="100.0" velocity="2.0"/><dynamics damping="2.0" friction="1.0"/></joint>
  <link name="link_2">
    <visual><origin xyz="0 0 0.2"/><geometry><box size="0.065 0.085 0.38"/></geometry></visual>
    <visual><origin xyz="-0.045 0 0.16"/><geometry><cylinder radius="0.014" length="0.26"/></geometry></visual>
    <visual><origin xyz="0 0 0.4" rpy="1.5708 0 0"/><geometry><cylinder radius="0.055" length="0.12"/></geometry></visual>
    <inertial><origin xyz="0 0 0.2"/><mass value="1.5"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.005"/></inertial>
  </link>
  <gazebo reference="link_2"><material>Gazebo/Orange</material><gravity>false</gravity></gazebo>

  <!-- ÖN KOL (ÇİFT ŞAFTLI + BİLEK MOTOR MUHAFAZASI) -->
  <joint name="joint_3" type="revolute"><parent link="link_2"/><child link="link_3"/><origin xyz="0 0 0.4" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" effort="80.0" velocity="2.0"/><dynamics damping="2.0" friction="1.0"/></joint>
  <link name="link_3">
    <visual><origin xyz="0 0 0.14"/><geometry><box size="0.048 0.062 0.28"/></geometry></visual>
    <visual><origin xyz="0.032 0 0.14"/><geometry><cylinder radius="0.01" length="0.24"/></geometry></visual>
    <visual><origin xyz="0 0 0.285"/><geometry><cylinder radius="0.042" length="0.03"/></geometry></visual>
    <inertial><origin xyz="0 0 0.15"/><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.002"/></inertial>
  </link>
  <gazebo reference="link_3"><material>Gazebo/DarkGrey</material><gravity>false</gravity></gazebo>

  <!-- DÖNER BİLEK + TURKUAZ LED HALKA -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="50.0" velocity="2.5"/>
    <dynamics damping="1.5" friction="0.5"/>
  </joint>
  <link name="gripper_base">
    <visual><origin xyz="0 0 0.012"/><geometry><cylinder radius="0.044" length="0.024"/></geometry></visual>
    <visual><origin xyz="0 0 0.035"/><geometry><box size="0.125 0.045 0.03"/></geometry></visual>
    <collision><origin xyz="0 0 0.025"/><geometry><box size="0.12 0.04 0.05"/></geometry></collision>
    <inertial><mass value="0.2"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <gazebo reference="gripper_base"><material>Gazebo/Turquoise</material><gravity>false</gravity></gazebo>

  <!-- HASSAS ÇENELİ PARMAKLAR -->
  <joint name="finger_left_joint" type="prismatic"><parent link="gripper_base"/><child link="finger_left"/><origin xyz="-0.04 0 0.05" rpy="0 0 0"/><axis xyz="1 0 0"/><limit lower="0.0" upper="0.035" effort="50.0" velocity="0.5"/><dynamics damping="1.0" friction="1.0"/></joint>
  <link name="finger_left">
    <visual><origin xyz="0 0 0.05"/><geometry><box size="0.01 0.032 0.1"/></geometry></visual>
    <visual><origin xyz="-0.006 0 0.025"/><geometry><box size="0.008 0.024 0.045"/></geometry></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><box size="0.01 0.03 0.1"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <gazebo reference="finger_left"><material>Gazebo/Orange</material><gravity>false</gravity></gazebo>

  <joint name="finger_right_joint" type="prismatic"><parent link="gripper_base"/><child link="finger_right"/><origin xyz="0.04 0 0.05" rpy="0 0 0"/><axis xyz="-1 0 0"/><limit lower="0.0" upper="0.035" effort="50.0" velocity="0.5"/><dynamics damping="1.0" friction="1.0"/></joint>
  <link name="finger_right">
    <visual><origin xyz="0 0 0.05"/><geometry><box size="0.01 0.032 0.1"/></geometry></visual>
    <visual><origin xyz="0.006 0 0.025"/><geometry><box size="0.008 0.024 0.045"/></geometry></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><box size="0.01 0.03 0.1"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <gazebo reference="finger_right"><material>Gazebo/Orange</material><gravity>false</gravity></gazebo>

  <gazebo>
    <plugin name="gazebo_ros_joint_pose_trajectory" filename="libgazebo_ros_joint_pose_trajectory.so">
      <always_on>true</always_on><update_rate>50</update_rate>
    </plugin>
  </gazebo>
</robot>
